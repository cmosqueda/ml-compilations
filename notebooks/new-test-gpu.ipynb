   "source": [
    "import tensorflow as tf\n",
    "\n",
    "gpu_devices = tf.config.list_physical_devices('GPU')\n",
    "\n",
    "if gpu_devices:\n",
    "    print(f\"GPU(s) found: {gpu_devices}\")\n",
    "    print(\"TensorFlow is configured to use the GPU.\")\n",
    "else:\n",
    "    print(\"No GPU found. TensorFlow is set to run on CPU.\")\n"
   ]
  }
